FROM python:3.11-slim

# Single source of truth for the server version. It MUST equal the
# `chromadb==` pin in src/orchestrator/requirements.txt (the client) -
# scripts/check-chroma-version.sh enforces that in CI.
ARG CHROMADB_VERSION=1.5.9

WORKDIR /chroma

RUN pip install --no-cache-dir "numpy<2.0.0" chromadb==${CHROMADB_VERSION}

EXPOSE 8000

# Run natively (will run as container-root, mapped safely by Podman)
CMD ["chroma", "run", "--host", "0.0.0.0", "--port", "8000", "--path", "/chroma/chroma"]
